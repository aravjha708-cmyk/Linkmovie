# ==========================================
# Asset Download Link Monetizer Environment Variables
# ==========================================

# Secure administrator password for dashboard login
# Change this before deploying to production!
ADMIN_PASSWORD=YourStrongAdminPasswordHere

# Optional PBKDF2 pre-hashed password (salt:hash)
# If provided, ADMIN_PASSWORD_HASH takes precedence over ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=

# Cryptographic secret for signing session tokens and flow verification tokens
# Must be a long, random string (at least 32 characters)
SESSION_SECRET=super_secret_session_and_flow_hmac_signing_key_32chars_min

# Netlify Blobs Configuration (Automatically injected by Netlify during deployment)
# For local development outside Netlify CLI, local JSON fallback storage is used.
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
